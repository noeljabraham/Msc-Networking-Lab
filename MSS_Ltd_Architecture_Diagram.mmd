flowchart TB
    Internet((Internet / ISP))
    ISP[ISP-R1<br/>Internet Router]
    Edge[EDGE-R1<br/>Company Edge Router<br/>NAT + Default Route]
    FW[Firewall / Edge ACLs<br/>Optional ASA or Router ACLs]

    Core1[CORE-SW1<br/>Multilayer Switch<br/>Inter-VLAN Routing]
    Core2[CORE-SW2<br/>Redundant Multilayer Switch]

    F1[SW-F1-MKT<br/>Floor 1 Access Switch]
    F2[SW-F2-SALES<br/>Floor 2 Access Switch]
    F3[SW-F3-SUPPORT<br/>Floor 3 Access Switch]
    ServerSW[SW-SERVER<br/>Server Farm Switch<br/>Connects VLAN 40 and VLAN 60 servers]

    MKT[Marketing PCs x20<br/>VLAN 10<br/>192.168.10.0/27]
    SALES[Sales PCs x25<br/>VLAN 20<br/>192.168.20.0/26]
    SUPPORT[General Support PCs x15<br/>VLAN 30<br/>192.168.30.0/27]
    ADMIN[Admin PC<br/>VLAN 50<br/>192.168.50.0/28]

    subgraph ServerFarm[Server Farm]
        direction TB
        ProdServices[Production Services<br/>VLAN 40 Servers<br/>DNS .10, Mail .11, Intranet .12]
        DBGroup[Database Servers<br/>VLAN 40 Servers<br/>MKT DB .20, Sales DB .21, Support DB .22]
        BackupDB[Backup Database Server<br/>VLAN 60 Backup<br/>192.168.60.10]
        BackupFile[Backup File/Archive Server<br/>VLAN 60 Backup<br/>192.168.60.11]
    end

    Internet --- ISP
    ISP --- Edge
    Edge --- FW
    FW --- Core1
    FW -. optional backup/core path .- Core2

    Core1 === Core2

    Core1 --- F1
    Core2 --- F1
    Core1 --- F2
    Core2 --- F2
    Core1 --- F3
    Core2 --- F3
    Core1 --- ServerSW
    Core2 --- ServerSW

    F1 --- MKT
    F2 --- SALES
    F3 --- SUPPORT
    F3 --- ADMIN

    ServerSW --- ProdServices
    ServerSW --- DBGroup
    ServerSW --- BackupDB
    ServerSW --- BackupFile

    classDef edge fill:#f7f7f7,stroke:#333,stroke-width:1px,color:#111;
    classDef core fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px,color:#111;
    classDef access fill:#dcfce7,stroke:#15803d,stroke-width:1px,color:#111;
    classDef users fill:#fef3c7,stroke:#b45309,stroke-width:1px,color:#111;
    classDef servers fill:#fee2e2,stroke:#b91c1c,stroke-width:1px,color:#111;

    class Internet,ISP,Edge,FW edge;
    class Core1,Core2 core;
    class F1,F2,F3,ServerSW access;
    class MKT,SALES,SUPPORT,ADMIN users;
    class ProdServices,DBGroup,BackupDB,BackupFile servers;
