flowchart TB
    InternetServer[INTERNET-SRV<br/>External Internet Test Server<br/>198.51.100.10/24]
    ISP[ISP-R1<br/>2911 ISP Router<br/>G0/1: 198.51.100.1/24]
    Edge[EDGE-R1<br/>2911 Company Edge Router<br/>NAT Overload + Default Route]

    Core1[CORE-SW1<br/>3560-24PS Multilayer Switch<br/>SVIs + HSRP + Inter-VLAN Routing]
    Core2[CORE-SW2<br/>3560-24PS Multilayer Switch<br/>SVIs + HSRP + Inter-VLAN Routing]

    MktSW[SW-MKT<br/>2960-24TT<br/>Floor 1 - Marketing]
    SalesA[SW-SALES-A<br/>2960-24TT<br/>Floor 2 - Sales PCs 01-24]
    SalesB[SW-SALES-B<br/>2960-24TT<br/>Floor 2 - Sales PC 25 + Growth]
    SupportSW[SW-SUPPORT<br/>2960-24TT<br/>Floor 3 - General Support]
    ServerSW[SW-SERVER<br/>2960-24TT<br/>Server Room]

    MKT[Marketing PCs x20<br/>VLAN 10 - 192.168.10.0/27<br/>Gateway 192.168.10.1]
    SALES[Sales PCs x25<br/>VLAN 20 - 192.168.20.0/26<br/>Gateway 192.168.20.1]
    SUPPORT[Support PCs x15<br/>VLAN 30 - 192.168.30.0/27<br/>Gateway 192.168.30.1]

    subgraph ServerRoom[Server Room]
        direction TB
        Prod[INFRA-SRV .10<br/>MAIL-SRV .11<br/>INTRANET-SRV .12<br/>VLAN 40 - 192.168.40.0/27]
        DB[MKT-DB-SRV .20<br/>SALES-DB-SRV .21<br/>SUPPORT-DB-SRV .22<br/>VLAN 40]
        Admin[ADMIN-PC<br/>VLAN 50 - 192.168.50.0/28<br/>Gateway 192.168.50.1]
        Backup[BACKUP-DB-SRV 192.168.60.10<br/>ARCHIVE-SRV 192.168.60.11<br/>Protected VLAN 60 - 192.168.60.0/28]
    end

    InternetServer -- "Public LAN 198.51.100.0/24" --> ISP
    ISP -- "WAN 203.0.113.0/30" --> Edge
    Edge -- "G0/0 to Fa0/24 - 10.255.0.0/30" --> Core1
    Edge -- "G0/1 to Fa0/24 - 10.255.0.4/30" --> Core2
    Core1 == "Gi0/1 802.1Q core trunk - VLANs 10,20,30,40,50,60,99" ==> Core2

    Core1 -- "Primary trunk" --> MktSW
    Core2 -. "Redundant trunk" .-> MktSW
    Core1 -- "Primary trunk" --> SalesA
    Core2 -. "Redundant trunk" .-> SalesA
    Core1 -- "Primary trunk" --> SalesB
    Core2 -. "Redundant trunk" .-> SalesB
    Core1 -- "Primary trunk" --> SupportSW
    Core2 -. "Redundant trunk" .-> SupportSW
    Core1 -- "Primary trunk" --> ServerSW
    Core2 -. "Redundant trunk" .-> ServerSW

    MktSW --> MKT
    SalesA --> SALES
    SalesB --> SALES
    SupportSW --> SUPPORT
    ServerSW --> Prod
    ServerSW --> DB
    ServerSW --> Admin
    ServerSW --> Backup

    Native[Native and unused-port VLAN 99<br/>No user hosts]
    Core2 -. "Trunk native VLAN" .-> Native

    classDef external fill:#f9fafb,stroke:#374151,stroke-width:2px,color:#111827;
    classDef core fill:#dbeafe,stroke:#1d4ed8,stroke-width:3px,color:#111827;
    classDef access fill:#dcfce7,stroke:#15803d,stroke-width:2px,color:#111827;
    classDef users fill:#fef3c7,stroke:#b45309,stroke-width:2px,color:#111827;
    classDef servers fill:#fee2e2,stroke:#b91c1c,stroke-width:2px,color:#111827;
    classDef management fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#111827;
    classDef native fill:#f3f4f6,stroke:#6b7280,stroke-width:2px,color:#111827;

    class InternetServer,ISP,Edge external;
    class Core1,Core2 core;
    class MktSW,SalesA,SalesB,SupportSW,ServerSW access;
    class MKT,SALES,SUPPORT users;
    class Prod,DB,Backup servers;
    class Admin management;
    class Native native;
